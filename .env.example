# PropIntel AI Environment Variables

# Database Connection (PostgreSQL + pgvector for Docker/Production, SQLite for local standalone)
DATABASE_URL=postgresql://postgres:postgres@db:5432/propintel

# OpenRouter Free LLM API
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings & Vector Search
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.25
TOP_K_CHUNKS=6

# Admin Security
ADMIN_API_KEY=propintel-admin-secret-2026

# Postgres credentials (for Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=propintel
